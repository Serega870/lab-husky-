function add(a, b) {
  return a + b;
}

function sub(a, b) {
  return a - b;
}

function mul(a, b) {
  return a * b;
}

function div(a, b) {
  if (b === 0) {
    return "На ноль делить нельзя";
  }
  return a / b;
}

const result = add(5, 3);
console.log("Результат:", result);
console.log("Вычитание:", sub(10, 4));
console.log("Умножение:", mul(2, 6));
console.log("Деление:", div(10, 2));
